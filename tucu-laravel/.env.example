APP_NAME="TUCU Backend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Nairobi
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── DATABASE (MySQL) ─────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tucu_db
DB_USERNAME=tucu_user
DB_PASSWORD=change_this_password

# ── SESSION / CACHE ──────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ── SANCTUM ──────────────────────────────────────────────────
# Comma-separated list of domains/ports allowed to receive stateful
# (cookie-based) requests. Bearer-token auth (used by this project)
# does not strictly require this, but it's good to set for SPA use.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:5500

# ── MAIL (optional, for future notifications) ───────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="cu@tharaka.ac.ke"
MAIL_FROM_NAME="${APP_NAME}"
